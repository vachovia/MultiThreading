    void DisplayTime()
    {
        // currentTime = DateTime.Now.ToString(); // This works fine.

        // Thread thread = new Thread(() =>
        // {
        //     Thread.Sleep(500);
        //     currentTime = DateTime.Now.ToString();
        //     StateHasChanged(); // This will throw an exception.
        // });
        // thread.Start();

        Thread thread = new Thread(() =>
        {
            Thread.Sleep(500);
            currentTime = DateTime.Now.ToString();
            base.InvokeAsync(StateHasChanged);
        });
        thread.Start();
    }

}
